{
  "manifest_version": 3,
  "name": "Free the Right-Click",
  "version": "1.1.0",
  "description": "Restores right-click menus, text selection, and copy/paste on pages that try to block them. On by default; per-site disable for apps with legit custom menus (Gutenberg, Google Docs, Figma, etc.).",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Free the Right-Click",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "popup.html"
  },
  "permissions": ["scripting", "storage", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["unblocker.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
